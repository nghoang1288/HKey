#include <windows.h>
#include "resource.h"

#ifndef HKEY_VERSION_STR
#define HKEY_VERSION_STR "1.0.25"
#endif

IDI_APP ICON "HKey.ico"
1 24 "HKey.manifest"
IDR_SOUND_VI RCDATA "Sounds/SwitchToVietnamese.wav"
IDR_SOUND_EN RCDATA "Sounds/SwitchToEnglish.wav"
IDR_EMOJI_JSON RCDATA "Emoji.json"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,25,0
 PRODUCTVERSION 1,0,25,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "nghoang1288"
      VALUE "FileDescription", "HKey - Vietnamese typing"
      VALUE "FileVersion", HKEY_VERSION_STR
      VALUE "InternalName", "HKey"
      VALUE "LegalCopyright", "GPL-3.0. Based on Vikey / OpenKey."
      VALUE "OriginalFilename", "HKey.exe"
      VALUE "ProductName", "HKey"
      VALUE "ProductVersion", HKEY_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
